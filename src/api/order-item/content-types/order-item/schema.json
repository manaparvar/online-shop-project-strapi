{
  "kind": "collectionType",
  "collectionName": "order_items",
  "info": {
    "singularName": "order-item",
    "pluralName": "order-items",
    "displayName": "order_item"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "key": {
      "type": "uid"
    },
    "order_id": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::order.order"
    },
    "product_id": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product.product"
    },
    "quantity": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "price_at_purchase": {
      "type": "decimal",
      "required": true,
      "default": 0,
      "min": 0
    }
  }
}
