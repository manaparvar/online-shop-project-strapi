{
  "kind": "collectionType",
  "collectionName": "reviews",
  "info": {
    "singularName": "review",
    "pluralName": "reviews",
    "displayName": "review"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "key": {
      "type": "uid",
      "required": true
    },
    "rating": {
      "type": "integer",
      "required": false,
      "default": 0,
      "min": 0,
      "max": 5
    },
    "product_id": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product.product"
    },
    "user_id": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "parent_id": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::review.review"
    },
    "like": {
      "type": "integer"
    }
  }
}
